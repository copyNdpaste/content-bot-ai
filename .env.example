# ============================================================
# content-bot-ai 환경변수 템플릿
# 이 파일을 .env 로 복사 후 값 채우기 (cp .env.example .env)
# 실제 .env 는 .gitignore — 절대 git 에 올리지 마세요.
# ============================================================

# === 메인 Meta 앱 (Threads 용) ===
META_APP_ID=
META_APP_SECRET=

# === Instagram sub-앱 ===
META_IG_APP_ID=
META_IG_APP_SECRET=

# === 단기 토큰 (OAuth 후 한 번만 — bootstrap 시 60일 장기로 자동 교환) ===
META_THREADS_SHORT_TOKEN_JP=
META_THREADS_SHORT_TOKEN_KR=
META_IG_SHORT_TOKEN_JP=
META_IG_SHORT_TOKEN_KR=

# === X (Twitter) OAuth 2.0 ===
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_TOKEN_JP=
X_OAUTH_REFRESH_TOKEN_JP=
X_OAUTH_TOKEN_KR=
X_OAUTH_REFRESH_TOKEN_KR=

# === Slack (인터랙티브 승인 루프) ===
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# === Codex 콘텐츠 문구 생성 ===
# OpenAI API 키를 직접 쓰지 않고 로컬 Codex CLI 를 호출.
CODEX_BIN=/Users/hoony/.local/bin/codex
CODEX_TEXT_MODEL=
CODEX_TEXT_TIMEOUT_SEC=180
# Codex 실패 시 기존 Claude CLI 폴백 허용: claude | none
CONTENT_LLM_FALLBACK=claude

# === DB 기반 페르소나/청자/컨셉 변주 ===
# auto: Supabase 설정이 있으면 DB 사용, 없으면 config/content_styles.json 사용
# supabase: DB만 사용 시도, json: 로컬 JSON만 사용
CONTENT_STYLE_SOURCE=auto
# content-bot Supabase REST 설정. 실제 키는 .env에만 넣고 문서/README/커밋에 넣지 말 것.
CONTENT_STYLE_SUPABASE_URL=
CONTENT_STYLE_SUPABASE_KEY=
# 생성 프롬프트/이미지 URL/Slack 결과를 content_generation_artifacts에 저장
CONTENT_LEARNING_LOG_ENABLED=true

# === AI 이미지 생성 (동적 프롬프트 -> 로컬 렌더러) ===
# CODEX_IMAGE_COMMAND 는 {prompt}, {output}, {width}, {height} 플레이스홀더를 사용할 수 있음.
# 실제 프롬프트는 매번 생성된 글을 기반으로 Codex가 새로 만든 뒤 {prompt}로 전달함.
CODEX_IMAGE_COMMAND=.venv/bin/python scripts/generate_codex_image.py --prompt {prompt} --output {output} --width {width} --height {height}
CODEX_IMAGE_TIMEOUT_SEC=600
# 이미지 자동 생성 대상 플랫폼: instagram,threads,x 또는 all
IMAGE_PLATFORMS=instagram,threads,x

# Instagram 게시에는 공개 HTTPS 이미지 URL 이 필요함. 커맨드는 stdout 마지막 줄에 URL 출력.
# Cloudinary 설정 후 아래 기본값 사용 가능.
IMAGE_PUBLIC_URL_COMMAND=.venv/bin/python scripts/upload_cloudinary.py --file {file}
IMAGE_PUBLIC_URL_TIMEOUT_SEC=180
CLOUDINARY_CLOUD_NAME=
# unsigned preset 방식이면 CLOUDINARY_UPLOAD_PRESET 만 필요.
CLOUDINARY_UPLOAD_PRESET=
# signed 방식이면 API key/secret 사용.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=content-bot-ai

# === Telegram 알림 (선택) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 자율 워크플로우 ===
# 회차마다 랜덤 간격 (분 단위 정밀) — 봇 패턴 회피
ROUTINE_MIN_HOURS=2.0          # 하한 (시간)
ROUTINE_MAX_HOURS=3.0          # 상한
ROUTINE_ACTIVE_START_HOUR=9    # KST 기준 자동 업로드 시작
ROUTINE_ACTIVE_END_HOUR=23     # KST 기준 이 시각부터 다음날까지 대기
# (legacy) ROUTINE_INTERVAL_HOURS 가 있으면 위 두 변수 무시하고 고정 간격
# ROUTINE_INTERVAL_HOURS=4
ROUTINE_PLATFORMS=threads,instagram,x
ROUTINE_ACCOUNTS=jp,kr
ROUTINE_DISABLED_TARGETS=             # 예: instagram:jp,x:kr
ROUTINE_LANGS=ko,ja
