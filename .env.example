# ============================================================
# content-bot-ai 환경변수 템플릿
# 이 파일을 .env 로 복사 후 값 채우기 (cp .env.example .env)
# 실제 .env 는 .gitignore — 절대 git 에 올리지 마세요.
# ============================================================

# === 메인 Meta 앱 (Threads 용) ===
META_APP_ID=
META_APP_SECRET=

# === Instagram sub-앱 ===
META_IG_APP_ID=
META_IG_APP_SECRET=

# === 단기 토큰 (OAuth 후 한 번만 — bootstrap 시 60일 장기로 자동 교환) ===
META_THREADS_SHORT_TOKEN_JP=
META_THREADS_SHORT_TOKEN_KR=
META_IG_SHORT_TOKEN_JP=
META_IG_SHORT_TOKEN_KR=

# === X (Twitter) OAuth 2.0 ===
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_TOKEN_JP=
X_OAUTH_REFRESH_TOKEN_JP=
X_OAUTH_TOKEN_KR=
X_OAUTH_REFRESH_TOKEN_KR=

# === Slack (인터랙티브 승인 루프) ===
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# === AI 이미지 생성 (Pollinations.ai) ===
# 키 0 — 완전 무료. 별도 ENV 변수 불필요.
# IG 게시 시 LLM 가 image prompt 생성 → Pollinations.ai (FLUX) → 자동 첨부.
# (Fal.ai 폴백은 추후 추가 예정 — FAL_API_KEY=)

# === Telegram 알림 (선택) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 자율 워크플로우 ===
# 회차마다 랜덤 간격 (분 단위 정밀) — 봇 패턴 회피
ROUTINE_MIN_HOURS=2.0          # 하한 (시간)
ROUTINE_MAX_HOURS=3.0          # 상한
# (legacy) ROUTINE_INTERVAL_HOURS 가 있으면 위 두 변수 무시하고 고정 간격
# ROUTINE_INTERVAL_HOURS=4
ROUTINE_PLATFORMS=threads,instagram,x
ROUTINE_ACCOUNTS=jp,kr
ROUTINE_LANGS=ko,ja
